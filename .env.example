# OPENAI_API_KEY: Required. Used server-side only (Vite dev middleware) to mint short-lived
# Realtime session tokens and describe images in documents. Never exposed to the browser.
OPENAI_API_KEY=

# Optional overrides
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_VISION_MODEL=gpt-5-mini
# OPENAI_VOICE=marin

# Firebase (optional): only needed to sign in with Google and load/comment on Google Docs.
# Without it you can still use the sample document or upload PDF/DOCX/TXT files.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
